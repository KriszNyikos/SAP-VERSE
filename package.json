{
  "name": "sap-verse",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/notifications": "^1.1.0",
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.16.0",
    "@cap-js/sqlite": "^2.4",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.17.0",
    "tsx": "^4",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build:types": "cds build --for typescript",
    "typecheck": "npm run build:types && tsc --noEmit",
    "watch-galactic_report_page": "cds watch --open galacticreportpage/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/galactic.db"
        }
      },
      "auth": {
        "users": {
          "alice": {
            "attr": {
              "planetCode": "MARS"
            },
            "roles": [
              "Analyst"
            ]
          },
          "bob": {
            "attr": {
              "planetCode": "EARTH"
            },
            "roles": [
              "Analyst"
            ]
          },
          "luke": {
            "attr": {
              "planetCode": "SATURN"
            },
            "roles": [
              "Analyst"
            ]
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/galactic_report_page"
  ]
}

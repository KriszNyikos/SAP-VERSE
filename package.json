{
  "name": "sap-verse",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@cap-js/cds-types": "^0.16.0",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^6.0.0",
    "@cap-js/cds-typer": ">=0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build:types": "cds build --for typescript",
    "typecheck": "npm run build:types && tsc --noEmit"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/galactic.db"
        }
      },
      "auth": {
        "users": {
          "alice": {
            "attr": {
              "planetCode": "MARS"
            },
            "roles": [
              "Analyst"
            ]
          },
          "bob": {
            "attr": {
              "planetCode": "EARTH"
            },
            "roles": [
              "Analyst"
            ]
          },
          "luke": {
            "attr": {
              "planetCode": "SATURN"
            },
            "roles": [
              "Analyst"
            ]
          }
        }
      }
    }
  }
}
